# ── Per-node Besu settings ───────────────────────────────────────────────────
# Copy to ".env" ON EACH VPS and fill in for THAT node.

# This node's PUBLIC IP address (so peers can dial back in).
P2P_HOST=203.0.113.10

# Comma-separated enode URLs of the OTHER validator nodes (the bootnodes).
# Format: enode://<node-public-key-no-0x>@<public-ip>:30303
# Get each node's public key from Phase 1 output (nodeXXXX/) or from
# `docker compose logs besu | grep enode` on first boot.
BOOTNODES=enode://PUBKEY1@203.0.113.11:30303,enode://PUBKEY2@203.0.113.12:30303,enode://PUBKEY3@203.0.113.13:30303

# CORS origins for JSON-RPC. Use "all" only behind a firewall/nginx.
# In production set this to your app's gateway origin.
RPC_CORS_ORIGINS=all
